# WeWe RSS 20004 Edition 部署配置
PORT=4000

# 请部署前修改成你自己的复杂访问授权码
AUTH_CODE=change-me-20004

# 如果只在本机访问保持 localhost；公网部署改成域名，例如 https://rss.example.com
SERVER_ORIGIN_URL=http://localhost:4000

FEED_MODE=fulltext
ENABLE_CLEAN_HTML=true
UPDATE_DELAY_TIME=60
MAX_REQUEST_PER_MINUTE=60
CRON_EXPRESSION=35 5,17 * * *

# 原 WeWe-RSS 的微信读书转发服务
PLATFORM_URL=https://weread.111965.xyz
